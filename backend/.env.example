# ==============================================================================
# Consenzo Backend Environment Configuration Template
# Copy this file to .env.local for local testing:
#   cp .env.example .env.local
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==============================================================================

# LLM Provider Configuration
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Secret API Key (Server-side only - NEVER commit real keys or expose to frontend)
NVIDIA_API_KEY=your_nvidia_api_key_here

# AWS Configuration (Used for local mock / local testing)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=consenzo-core-dev
CATALOG_BUCKET_NAME=consenzo-catalogs-dev
CATALOG_VERSION=smart-tv-v1
API_STAGE=dev
